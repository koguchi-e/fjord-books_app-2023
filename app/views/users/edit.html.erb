<h1><%= t('.page_title') %></h1>
<%= form_with(model: @user) do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red">
      <h2><%= t('views.common.validation_error', errors: i18n_error_count(@user.errors.count), name: User.model_name.human.downcase) %>:</h2>

      <ul>
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <b><%= User.human_attribute_name(:name) %></b>：<br>
    <%= form.text_field :name %>
  </div>

  <div>
    <b><%= User.human_attribute_name(:email) %></b>：<br>
    <%= form.text_field :email %>
  </div>

  <div>
    <b><%= User.human_attribute_name(:post_code) %></b>：<br>
    <%= form.text_field :post_code %>
  </div>

  <div>
    <b><%= User.human_attribute_name(:address) %></b>：<br>
    <%= form.text_field :address %>
  </div>

  <div>
    <b><%= User.human_attribute_name(:introduction) %></b>：<br>
    <%= form.text_area :introduction %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
