<table>
  <tbody>
    <% @report.comments.each do |comment| %>
    <tr>
      <td>
        <%= link_to user_path(comment.user) do %>
          <!-- <%= image_tag comment.user.get_profile_image, size: "50x50" %><br> -->
          <%= comment.user.name %>
        <% end %>
      </td>
      <td><%= comment.body %></td>
      <td>
        <% if comment.user == current_user %>
          <!-- <%= link_to "Destroy", book_bookcomment_path(book, bookcomment), method: :delete, class: "btn btn-sm btn-danger float-end" %> -->
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
