<% comment = @comment %>
<%= form_with(model: [commentable, comment], local:true) do |form| %>
  <% if comment.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(comment.errors.count, "error") %> <%= t("message.error , model: Comment.model_name.human(count: 1)") %> </h2>
      <ul>
        <% comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="index-item">
    <h3><%= t("page_title.new", model: Comment.model_name.human(count: 1)) %></h3>
    <div>
      <%= form.label :body, style: "display: block" %>
      <%= form.text_field :body, required: true %>
    </div>

    <div>
      <%= form.submit %>
    </div>
  </div>
<% end %>
