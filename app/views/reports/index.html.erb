<p style="color: green"><%= notice %></p>

<h1><%= Report.model_name.human(count: 1) %></h1>

<div id="reports">
  <% @reports.each do |report| %>
    <%= render report %>
    <p>
      <%= link_to "Show this report", report %>
    </p>
  <% end %>
</div>

<%= link_to "New report", new_report_path %>
