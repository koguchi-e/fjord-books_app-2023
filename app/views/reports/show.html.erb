<h1><%= t("page_title.show", model: Report.model_name.human(count: 1)) %></h1>

<div class="show-item">
  <%= render @report %>
</div>

<div class="show-item">
  <table>
  <tbody>
    <% @report.comments.each do |comment| %>
    <tr>
      <td>
        <%= link_to user_path(comment.user) do %>
          <!-- <%= image_tag comment.user.get_profile_image, size: "50x50" %><br> -->
          <%= comment.user.name %>
        <% end %>
      </td>
      <td><%= comment.body %></td>
      <td>
        <% if comment.user == current_user %>
          <!-- <%= link_to "Destroy", book_bookcomment_path(book, bookcomment), method: :delete, class: "btn btn-sm btn-danger float-end" %> -->
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
</div>

<%= render "comments/form", report: @report, comment: @comment %>

<nav class="page-nav">
  <% if @report.user.id == current_user.id %>
    <%= link_to t("button.edit", model: Report.model_name.human(count: 1)), edit_report_path(@report) %> |
  <% end %>
  <%= link_to t("button.index", model: Report.model_name.human(count: 2)), reports_path %>
  <% if @report.user.id == current_user.id %>
    <%= button_to t("button.destroy", model: Report.model_name.human(count: 1)), @report, method: :delete %>
  <% end %>
</nav>
