<p style="color: green"><%= notice %></p>

<h1><%= t('.page_title', default: 'Books') %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
  <div class="index-item">
    <%= render book %>
    <p>
      <%= link_to t("button.show_book"), book %>
    </p>
  </div>
<% end %>

<nav class="page-nav">
  <%= link_to t("button.new_book"), new_book_path %>
</nav>
